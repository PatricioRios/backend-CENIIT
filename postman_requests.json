									"script": {
										"exec": [
											"",
											"",
											"// 1. Revisa si el código de respuesta es 401 (No autorizado)",
											"if (pm.response.code === 401) {",
											"    console.log(\"Respuesta 401 detectada. Solicitando un nuevo token...\");",
											"    // 2. Define la petición para obtener un nuevo token",
											"    pm.sendRequest({",
											"        url: 'http://localhost:3030/realms/develop-spring-realm/protocol/openid-connect/token',",
											"        method: 'POST',",
											"        header: {",
											"            'Content-Type': 'application/x-www-form-urlencoded'",
											"        },",
											"        body: {",
											"            mode: 'urlencoded',",
											"            urlencoded: [",
											"                {key: \"grant_type\", value: \"password\"},",
											"                {key: \"client_id\", value: \"ceniit-backend-develop\"},",
											"                {key: \"client_secret\", value: \"Oe8hlZYGa0xJwksIZqGCGJQTpGiou4Iy\"},",
											"                {key: \"username\", value: \"patriciorios\"},",
											"                {key: \"password\", value: \"1234\"}",
											"            ]",
											"        }",
											"    }, (err, response) => {",
											"        console.log(err);",
											"        console.log(response.body);",
											"        if (err) {",
											"            console.error(\"Error al solicitar el nuevo token:\", err);",
											"            return;",
											"        }",
											"        console.log(\"Nuevo token recibido exitosamente.\");",
											"        // 3. Extrae el nuevo token de la respuesta",
											"        const responseJson = response.json();",
											"        const newToken = responseJson.access_token;",
											"        // 4. Guarda el nuevo token en una variable de la colección",
											"        // Asegúrate de tener una variable llamada 'accessToken' en tu colección",
											"        pm.environment.set(\"JWT\", newToken);",
											"        console.log(\"Variable 'accessToken' actualizada.\");",
											"        // 5. (Opcional) Reintenta la petición original que falló",
											"        // Esto ejecutará la misma petición nuevamente, pero esta vez con el nuevo token",
											"        //console.log(\"Reintentando la petición original...\");",
											"        //postman.setNextRequest(pm.info.requestName);",
											"    });",
											"} "
										],
